{
   "name": "Demo API",
   "path": "/demoapi/v1",
   "state": "published",
   "retirementDate": "01.09.2050",
   "version": "1.0.0",
   "organization": "API Development",
   "backendBasepath": "http://localhost:4010",
   "securityProfiles": [
      {
         "name": "_default",
         "isDefault": true,
         "devices": [
            {
               "name": "OAuth (External)",
               "type": "oauthExternal",
               "order": 1,
               "properties": {
                  "tokenStore": "Okta as IDP",
                  "accessTokenLocation": "HEADER",
                  "authorizationHeaderPrefix": "Bearer",
                  "accessTokenLocationQueryString": "",
                  "scopesMustMatch": "Any",
                  "scopes": "resource.WRITE, resource.READ",
                  "removeCredentialsOnSuccess": "true",
                  "implicitGrantEnabled": "false",
                  "implicitGrantLoginEndpointUrl": "https://dev-725271.okta.com/oauth2/default/v1/authorize",
                  "implicitGrantLoginTokenName": "access_token",
                  "authCodeGrantTypeEnabled": "true",
                  "authCodeGrantTypeRequestEndpointUrl": "https://dev-725271.okta.com/oauth2/default/v1/authorize",
                  "authCodeGrantTypeRequestClientIdName": "client_id",
                  "authCodeGrantTypeRequestSecretName": "client_secret",
                  "authCodeGrantTypeTokenEndpointUrl": "https://dev-725271.okta.com/oauth2/default/v1/token",
                  "authCodeGrantTypeTokenEndpointTokenName": "access_code",
                  "clientCredentialsGrantTypeEnabled": "true",
                  "clientCredentialsGrantTypeTokenEndpointUrl": "https://dev-725271.okta.com/oauth2/default/v1/token",
                  "clientCredentialsGrantTypeTokenName": "access_token",
                  "useClientRegistry": "true",
                  "subjectSelector": "${oauth.token.client_id}",
                  "oauth.token.client_id": "${oauth.token.client_id}",
                  "oauth.token.scopes": "${oauth.token.scopes}",
                  "oauth.token.valid": "${oauth.token.valid}"
               }
            }
         ]
      }
   ]
}
